+import { container } from "../../platform/container.js";
+
+/** Resolve the right VCS client for a repo's provider. */
+export function resolveVcsClient(repo: { provider: "github" | "gitlab" }) {
+  if (repo.provider === "gitlab") {
+    return container.gitlab();
+  }
+  return container.github();
+}
