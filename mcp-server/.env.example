# Base URL of the local DevDigest Fastify API. Start it first with
# `./scripts/dev.sh` from the repo root (default port 3001).
DEVDIGEST_API_URL=http://localhost:3001

# Poll interval (ms) for the run_agent_on_pr timeout-fallback loop, which
# polls GET /pulls/:id/reviews only if the synchronous POST /pulls/:id/review
# call would otherwise exceed MCP_HARD_TIMEOUT_MS.
MCP_POLL_INTERVAL_MS=2000

# Hard ceiling (ms) for the run_agent_on_pr poll loop before returning a
# timeout-fallback result instead of blocking forever.
MCP_HARD_TIMEOUT_MS=120000

# Per-request timeout (ms) applied to every individual HTTP call this server
# makes to the DevDigest API.
MCP_REQUEST_TIMEOUT_MS=30000
